{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stockora",
  "main": "server/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stockora-db",
      "database_id": "fdb67cf9-3d3c-4713-80fc-5e8d7e74b02f"
    }
  ],
  "dev": {
    "port": 8787
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
